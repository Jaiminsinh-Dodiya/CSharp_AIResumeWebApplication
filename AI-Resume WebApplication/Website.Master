<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Website.Master.cs" Inherits="AI_Resume_WebApplication.Website" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ResumeAI - Autonomous AI Resume Builder &amp; Intelligence System</title>
    <meta name="description" content="Build ATS-optimized, executive-grade resumes with real-time AI intelligence, liquid glass styling, and instant PDF exports." />


    <link rel="stylesheet" href="assets/css/tokens.css" />
    <link rel="stylesheet" href="assets/css/reset.css" />
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/layout.css" />
    <link rel="stylesheet" href="assets/css/components.css" />
    <link rel="stylesheet" href="assets/css/theme.css" />
    <link rel="stylesheet" href="assets/css/animations.css" />
    <link rel="stylesheet" href="assets/css/pages.css" />
    <link rel="stylesheet" href="assets/css/utilities.css" />
    <link rel="stylesheet" href="assets/css/variables.css" />
    <link rel="stylesheet" href="assets/css/templates.css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

    
    <div class="ambient-canvas">
        <div class="ambient-blob blob-purple"></div>
        <div class="ambient-blob blob-indigo"></div>
        <div class="ambient-blob blob-cyan"></div>
    </div>

    <form id="form1" runat="server">

        
        <div id="appSidebar" runat="server" class="sidebar" visible="false">
            <div class="sidebar-header">
                <a href="Default.aspx" class="flex items-center gap-3">
                    <div class="stat-icon" style="width:32px; height:32px; background:var(--accent-primary-glow);">
                        <svg class="icon-svg" style="color:#FFF;" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    </div>
                    <span style="font-family:var(--font-heading); font-weight:800; font-size:var(--text-lg);" class="text-gradient-purple">ResumeAI</span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <a href="Dashboard.aspx" class='<%= "sidebar-item " + GetActiveClass("Dashboard.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                    Dashboard
                </a>
                <a href="ResumeBuilder.aspx" class='<%= "sidebar-item " + GetActiveClass("ResumeBuilder.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Resume Builder
                </a>
                <a href="Preview.aspx" class='<%= "sidebar-item " + GetActiveClass("Preview.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Resume Preview
                </a>
                <a href="CareerProfile.aspx" class='<%= "sidebar-item " + GetActiveClass("CareerProfile.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Career Profile
                </a>
                <a href="Templates.aspx" class='<%= "sidebar-item " + GetActiveClass("Templates.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M4 5h16M4 10h16M4 15h10"/></svg>
                    Templates
                </a>
                <a href="Analyzer.aspx" class='<%= "sidebar-item " + GetActiveClass("Analyzer.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    AI Analyzer
                </a>
                <a href="MockInterview.aspx" class='<%= "sidebar-item " + GetActiveClass("MockInterview.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14h-2v-2h2zm0-4h-2V7h2z"/></svg>
                    AI Mock Interview
                </a>
                <a href="Settings.aspx" class='<%= "sidebar-item " + GetActiveClass("Settings.aspx") %>'>
                    <svg class="icon-svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
                    Settings
                </a>
            </nav>

            <div style="padding:var(--space-4); border-top:1px solid var(--glass-border);">
                <div class="glass-card p-4 flex items-center gap-3">
                    <div style="width:36px; height:36px; border-radius:50%; background:var(--accent-primary); display:flex; align-items:center; justify-content:center; font-weight:700; color:#FFF;">AW</div>
                    <div style="flex:1; overflow:hidden;">
                        <h4 style="font-size:var(--text-xs); white-space:nowrap; text-overflow:ellipsis; overflow:hidden; margin:0;">Alexander Wright</h4>
                        <p style="font-size:10px; color:var(--text-muted); margin:0;">Pro Subscriber</p>
                    </div>
                    <a href="Login.aspx" title="Logout">
                        <svg class="icon-svg" style="width:16px; height:16px; color:var(--color-danger);" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                    </a>
                </div>
            </div>
        </div>

        <asp:ContentPlaceHolder ID="NavigationContent" runat="server">
            <header class="navbar" style="position:fixed; top:0; left:0; right:0; z-index:1000; background:rgba(10,10,20,0.85); backdrop-filter:blur(16px); border-bottom:1px solid var(--glass-border);">
                <div class="container navbar-inner">
                    <a href="Default.aspx" class="flex items-center gap-3">
                        <div class="stat-icon" style="width:36px; height:36px; background:var(--accent-primary-glow); border-color:var(--accent-primary);">
                            <svg class="icon-svg" style="color:#FFF;" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                        </div>
                        <span style="font-family:var(--font-heading); font-weight:800; font-size:var(--text-xl);" class="text-gradient-purple">ResumeAI</span>
                    </a>

                    <nav class="nav-links">
                        <a href="Features.aspx" class='<%= "nav-link " + GetActiveClass("Features.aspx") %>'>Features</a>
                        <a href="Default.aspx#how-it-works" class="nav-link">How It Works</a>
                        <a href="Templates.aspx" class='<%= "nav-link " + GetActiveClass("Templates.aspx") %>'>Templates</a>
                        <a href="Default.aspx#pricing" class="nav-link">Pricing</a>
                    </nav>

                    <div class="flex items-center gap-3">
                        <a href="Login.aspx" class="btn btn-ghost">Sign In</a>
                        <a href="Register.aspx" class="btn btn-primary">
                            Get Started Free
                            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </header>
        </asp:ContentPlaceHolder>

        <!-- ===================== MAIN CONTENT AREA ===================== -->
        <div id="mainWrap" runat="server" style="padding-top:90px; min-height:82vh;">

            <!-- APP TOPBAR (Shared across all app pages, toggled by AppPageBase) -->
            <div id="appTopbar" runat="server" class="dashboard-topbar flex items-center justify-between" visible="false">
                <div class="flex items-center gap-4">
                    <div style="position:relative; width:280px;">
                        <input type="text" class="form-input" placeholder="Search resumes, templates..." style="padding-left:36px;">
                        <svg class="icon-svg" style="position:absolute; left:10px; top:10px; width:16px; height:16px; color:var(--text-muted);" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <button type="button" class="btn btn-secondary btn-sm" title="Notifications">
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
                    </button>
                    <a href="ResumeBuilder.aspx" class="btn btn-primary btn-sm">
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                        Create New Resume
                    </a>
                </div>
            </div>

            <div id="contentInner" runat="server">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>

            <!-- ===================== FOOTER ContentPlaceHolder ===================== -->
            <!-- Default content: Public marketing footer.                             -->
            <!-- App pages override this with empty <asp:Content> to hide the footer.  -->
            <asp:ContentPlaceHolder ID="FooterContent" runat="server">
                <footer style="border-top:1px solid var(--glass-border); padding:var(--space-16) 0 var(--space-8) 0; background:var(--bg-primary);">
                    <div class="container">
                        <div class="grid grid-cols-4 gap-8" style="margin-bottom:var(--space-12);">
                            <div>
                                <div class="flex items-center gap-3" style="margin-bottom:var(--space-4);">
                                    <div class="stat-icon" style="width:32px; height:32px; background:var(--accent-primary-glow);">
                                        <svg class="icon-svg" style="color:#FFF;" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                                    </div>
                                    <span style="font-family:var(--font-heading); font-weight:800; font-size:var(--text-lg);" class="text-gradient-purple">ResumeAI</span>
                                </div>
                                <p style="font-size:var(--text-sm);">Autonomous AI Resume Builder &amp; Intelligence System. Designed with pure Liquid Glass CSS aesthetics.</p>
                            </div>

                            <div>
                                <h4 style="font-size:var(--text-sm); margin-bottom:var(--space-4); color:var(--text-primary);">Product</h4>
                                <ul style="display:flex; flex-direction:column; gap:8px; font-size:var(--text-sm); color:var(--text-secondary);">
                                    <li><a href="ResumeBuilder.aspx">AI Resume Builder</a></li>
                                    <li><a href="Templates.aspx">Resume Templates</a></li>
                                    <li><a href="Analyzer.aspx">ATS Analyzer</a></li>
                                    <li><a href="MockInterview.aspx">AI Mock Interview</a></li>
                                    <li><a href="CareerProfile.aspx">Career Profile</a></li>
                                </ul>
                            </div>

                            <div>
                                <h4 style="font-size:var(--text-sm); margin-bottom:var(--space-4); color:var(--text-primary);">Account</h4>
                                <ul style="display:flex; flex-direction:column; gap:8px; font-size:var(--text-sm); color:var(--text-secondary);">
                                    <li><a href="Dashboard.aspx">Dashboard</a></li>
                                    <li><a href="Settings.aspx">Settings</a></li>
                                    <li><a href="Login.aspx">Sign In</a></li>
                                    <li><a href="Register.aspx">Register</a></li>
                                </ul>
                            </div>

                            <div>
                                <h4 style="font-size:var(--text-sm); margin-bottom:var(--space-4); color:var(--text-primary);">Legal &amp; Support</h4>
                                <ul style="display:flex; flex-direction:column; gap:8px; font-size:var(--text-sm); color:var(--text-secondary);">
                                    <li><a href="Error404.aspx">404 Page</a></li>
                                    <li><a href="Error500.aspx">500 Error Page</a></li>
                                    <li><a href="#">Privacy Policy</a></li>
                                    <li><a href="#">Terms of Service</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="glass-divider"></div>

                        <div class="flex justify-between items-center" style="font-size:var(--text-xs); color:var(--text-muted);">
                            <p>&copy; 2026 ResumeAI System Inc. All rights reserved.</p>
                        </div>
                    </div>
                </footer>
            </asp:ContentPlaceHolder>
        </div>

        <!-- ===================== PAGE SCRIPTS ContentPlaceHolder ===================== -->
        <!-- Content pages can inject page-specific JavaScript here.                     -->
        <asp:ContentPlaceHolder ID="PageScripts" runat="server">
        </asp:ContentPlaceHolder>

    </form>

    <script src="assets/js/main.js"></script>
</body>
</html>
